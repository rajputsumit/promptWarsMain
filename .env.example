# ─── Supabase (auth + database) ──────────────────────────────────────────────
# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ─── Anthropic (AI companion, insights, guided meditations) ──────────────────
# Optional: without it the app falls back to built-in rule-based support.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ─── Site URL (OAuth redirects) ──────────────────────────────────────────────
# Local dev can leave this as-is. On Vercel it is derived automatically, but you
# may set it explicitly to your production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
